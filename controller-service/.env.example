# Optional: override path to controller YAML config (default: src/controller/core/config/config.yaml)
# CONTROLLER_CONFIG_FILE=/app/config/controller.yaml
PROJECT_NAME=controller
# WebSocket log streaming requires uvicorn[standard] (websockets) — see requirements.txt
DOCKER_SOCKET=unix:///var/run/docker.sock
CONTAINER_FRR=frr
CONTAINER_TESTER=tester
# Single-DUT defaults when `dut_devices` in config YAML is empty. Multiple DUTs: set `dut_devices` in YAML.
DUT_SSH_HOST=frr
DUT_SSH_PORT=22
DUT_SSH_USERNAME=root
DUT_SSH_PASSWORD=rootpassword
# Optional: path to known_hosts file inside the controller container
# DUT_SSH_KNOWN_HOSTS=/path/to/known_hosts
DUT_COMMAND_TIMEOUT=60
